@page "/tickets/{Id:guid}"

@using MudBlazor
@using ServiceDeskLite.Contracts.V1.Tickets

<PageTitle>Ticket Details</PageTitle>

@if (_isLoading)
{
    <div class="ticket-detail-page">
        <MudPaper Class="ticket-detail-surface ticket-detail-skeleton__header" Elevation="0">
            <MudSkeleton Width="96px" Height="24px" />
            <MudSkeleton Width="48%" Height="46px" />
            <MudSkeleton Width="72%" Height="20px" />

            <div class="ticket-detail-skeleton__signals">
                <MudSkeleton Width="112px" Height="30px" />
                <MudSkeleton Width="102px" Height="30px" />
            </div>
        </MudPaper>

        <div class="ticket-detail-layout">
            <div class="ticket-detail-main">
                <div class="ticket-tabs ticket-tabs--skeleton">
                    <MudSkeleton Width="120px" Height="42px" />
                    <MudSkeleton Width="148px" Height="42px" />
                    <MudSkeleton Width="132px" Height="42px" />
                </div>

                <MudPaper Class="ticket-detail-surface ticket-detail-skeleton__panel" Elevation="0">
                    @for (var i = 0; i < 4; i++)
                    {
                        <MudSkeleton Width="100%" Height="20px" Class="mb-2" />
                    }
                </MudPaper>
            </div>

            <div class="ticket-detail-sidebar">
                <MudPaper Class="ticket-detail-surface ticket-detail-skeleton__sidebar" Elevation="0">
                    @for (var i = 0; i < 5; i++)
                    {
                        <MudSkeleton Width="100%" Height="18px" Class="mb-3" />
                    }
                </MudPaper>
            </div>
        </div>
    </div>
}
else if (_error is not null)
{
    <AppErrorPanel Error="_error" />
}
else if (_ticket is null)
{
    <MudPaper Class="ticket-detail-surface ticket-detail-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                 Class="ticket-detail-empty__icon"
                 aria-hidden="true" />
        <h1 class="ticket-detail-empty__title">Ticket not found</h1>
        <p class="ticket-detail-empty__description">
            No ticket with this ID exists or it is no longer available.
        </p>
        <MudButton Variant="Variant.Outlined" Href="/tickets">
            Back to List
        </MudButton>
    </MudPaper>
}
else
{
    <div class="ticket-detail-page">
        <MudPaper Class="ticket-detail-surface ticket-detail-header" Elevation="0">
            <div class="ticket-detail-header__content">
                <span class="ticket-detail-header__ref">@FormatTicketRef(_ticket.Id)</span>
                <h1 class="ticket-detail-header__title">@_ticket.Title</h1>
                <p class="ticket-detail-header__summary">@BuildHeaderSummary(_ticket.Description)</p>

                <div class="ticket-detail-header__signals">
                    <span class="@($"ticket-detail-badge ticket-detail-badge--status {StatusBadgeClass(_ticket.Status)}")">
                        @FormatStatus(_ticket.Status)
                    </span>
                    <span class="@($"ticket-detail-badge ticket-detail-badge--priority {PriorityBadgeClass(_ticket.Priority)}")">
                        @FormatPriority(_ticket.Priority)
                    </span>
                </div>
            </div>

            <div class="ticket-detail-header__actions">
                <div class="ticket-detail-header__actions-copy">
                    <span class="ticket-detail-header__actions-label">Workflow actions</span>
                    <p class="ticket-detail-header__actions-note">@WorkflowActionNote</p>
                </div>

                <div class="ticket-detail-header__buttons">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Default"
                               Class="ticket-detail-header__button ticket-detail-header__button--primary"
                               OnClick="OpenChangeStatusDialogAsync"
                               Disabled="@(_ticket.AllowedTransitions.Count == 0)">
                        Change Status
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="ticket-detail-header__button"
                               OnClick="OpenAssignDialogAsync"
                               Disabled="@(_ticket.Status == TicketStatus.Closed)">
                        @(_ticket.Assignee is null ? "Assign" : "Reassign")
                    </MudButton>
                </div>
            </div>
        </MudPaper>

        <div class="ticket-detail-layout">
            <div class="ticket-detail-main">
                <nav class="ticket-tabs" aria-label="Ticket work areas">
                    <button type="button"
                            class="@TabClass(TicketDetailsTab.Details)"
                            @onclick="() => SelectTab(TicketDetailsTab.Details)"
                            aria-selected="@(_activeTab == TicketDetailsTab.Details)">
                        <span>Details</span>
                    </button>

                    <button type="button"
                            class="@TabClass(TicketDetailsTab.Comments)"
                            @onclick="() => SelectTab(TicketDetailsTab.Comments)"
                            aria-selected="@(_activeTab == TicketDetailsTab.Comments)">
                        <span>Comments</span>
                        <span class="ticket-tabs__count">@CommentCount</span>
                    </button>

                    <button type="button"
                            class="@TabClass(TicketDetailsTab.History)"
                            @onclick="() => SelectTab(TicketDetailsTab.History)"
                            aria-selected="@(_activeTab == TicketDetailsTab.History)">
                        <span>History</span>
                        <span class="ticket-tabs__count">@HistoryCount</span>
                    </button>
                </nav>

                <MudPaper Class="ticket-detail-surface ticket-panel" Elevation="0">
                    @if (_activeTab == TicketDetailsTab.Details)
                    {
                        <div class="ticket-panel__section">
                            <span class="ticket-panel__eyebrow">Description</span>
                            <div class="ticket-description">
                                @_ticket.Description
                            </div>
                        </div>

                        <div class="ticket-panel__section">
                            <span class="ticket-panel__eyebrow">Operational focus</span>
                            <p class="ticket-panel__text">@DetailsSummaryText</p>
                        </div>
                    }
                    else if (_activeTab == TicketDetailsTab.Comments)
                    {
                        <div class="ticket-conversation">
                            @if (_auditEventsError is not null)
                            {
                                <div class="ticket-panel__notice">
                                    Workflow events are temporarily unavailable. Comments remain visible below.
                                </div>
                            }

                            <div class="ticket-conversation__list">
                                @if (ConversationItems.Count == 0)
                                {
                                    <div class="ticket-conversation__empty">
                                        <span class="ticket-conversation__empty-title">No conversation yet</span>
                                        <p class="ticket-conversation__empty-copy">
                                            Use the reply area below to add the first internal note to this ticket.
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in ConversationItems)
                                    {
                                        if (item.Kind == ConversationItemKind.Comment && item.Comment is not null)
                                        {
                                            <article class="ticket-message">
                                                <div class="ticket-message__avatar">@CommentInitials(item.Comment.Author)</div>

                                                <div class="ticket-message__bubble">
                                                    <div class="ticket-message__header">
                                                        <div class="ticket-message__identity">
                                                            <span class="ticket-message__author">@DisplayAuthor(item.Comment.Author)</span>
                                                            <span class="ticket-message__channel">Internal note</span>
                                                        </div>

                                                        <span class="ticket-message__time">@FormatDateTime(item.Comment.CreatedAt)</span>
                                                    </div>

                                                    <div class="ticket-message__content">@item.Comment.Content</div>
                                                </div>
                                            </article>
                                        }
                                        else if (item.Kind == ConversationItemKind.SystemEvent && item.Event is not null)
                                        {
                                            <div class="ticket-system-event">
                                                <span class="ticket-system-event__line" aria-hidden="true"></span>

                                                <div class="ticket-system-event__content">
                                                    <MudIcon Icon="@EventIcon(item.Event.Payload)"
                                                             Class="ticket-system-event__icon"
                                                             aria-hidden="true" />

                                                    <div class="ticket-system-event__copy">
                                                        <span class="ticket-system-event__title">@FormatEventType(item.Event.Payload)</span>
                                                        <span class="ticket-system-event__detail">@FormatEventSummary(item.Event)</span>
                                                    </div>

                                                    <span class="ticket-system-event__time">@FormatDateTime(item.Event.OccurredAt)</span>
                                                </div>

                                                <span class="ticket-system-event__line" aria-hidden="true"></span>
                                            </div>
                                        }
                                    }
                                }
                            </div>

                            <div class="ticket-reply">
                                <div class="ticket-reply__header">
                                    <div>
                                        <h2 class="ticket-reply__title">Reply</h2>
                                        <p class="ticket-reply__copy">
                                            Add an internal working note for the service desk record.
                                        </p>
                                    </div>

                                    <div class="ticket-reply__channels" aria-label="Reply channel">
                                        <span class="ticket-reply__channel ticket-reply__channel--active">Internal note</span>
                                        <span class="ticket-reply__channel ticket-reply__channel--muted">Customer reply unavailable</span>
                                    </div>
                                </div>

                                <div class="ticket-reply__form">
                                    <MudTextField T="string"
                                                  Label="Author (optional)"
                                                  @bind-Value="_commentAuthor"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.None"
                                                  MaxLength="100"
                                                  Class="ticket-reply__author"
                                                  Disabled="_isSubmittingComment" />

                                    <MudTextField T="string"
                                                  Label="Internal note"
                                                  @bind-Value="_commentContent"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.None"
                                                  Lines="5"
                                                  MaxLength="2000"
                                                  Immediate="true"
                                                  Class="ticket-reply__content"
                                                  Disabled="_isSubmittingComment" />
                                </div>

                                @if (_commentError is not null)
                                {
                                    <AppErrorPanel Error="_commentError" />
                                }

                                <div class="ticket-reply__footer">
                                    <span class="ticket-reply__hint">
                                        Customer-facing replies are not yet modeled in the current ticket API.
                                    </span>

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Class="ticket-reply__submit"
                                               OnClick="SubmitCommentAsync"
                                               Disabled="@(_isSubmittingComment || string.IsNullOrWhiteSpace(_commentContent))">
                                        @if (_isSubmittingComment)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        }
                                        Add Internal Note
                                    </MudButton>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_activeTab == TicketDetailsTab.History)
                    {
                        @if (_auditEventsError is not null)
                        {
                            <AppErrorPanel Error="_auditEventsError" />
                        }
                        else if (_auditEvents is null || _auditEvents.Count == 0)
                        {
                            <div class="ticket-history__empty">
                                <span class="ticket-history__empty-title">No history yet</span>
                                <p class="ticket-history__empty-copy">
                                    Status changes, assignments and future workflow events will appear here.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="ticket-history">
                                @for (var i = 0; i < _auditEvents.Count; i++)
                                {
                                    var auditEvent = _auditEvents[i];

                                    <article class="ticket-history__item">
                                        <div class="ticket-history__rail">
                                            <span class="@($"ticket-history__marker {HistoryMarkerClass(auditEvent.Payload)}")">
                                                <MudIcon Icon="@EventIcon(auditEvent.Payload)"
                                                         Class="ticket-history__marker-icon"
                                                         aria-hidden="true" />
                                            </span>

                                            @if (i < _auditEvents.Count - 1)
                                            {
                                                <span class="ticket-history__line" aria-hidden="true"></span>
                                            }
                                        </div>

                                        <div class="ticket-history__content">
                                            <div class="ticket-history__top">
                                                <h2 class="ticket-history__title">@FormatEventType(auditEvent.Payload)</h2>
                                                <span class="ticket-history__time">@FormatDateTime(auditEvent.OccurredAt)</span>
                                            </div>

                                            <p class="ticket-history__summary">@FormatEventSummary(auditEvent)</p>

                                            @if (auditEvent.Payload is TicketCommentAddedPayload commentPayload)
                                            {
                                                <div class="ticket-history__preview">@commentPayload.Content</div>
                                            }
                                            else if (auditEvent.Payload is RawAuditEventPayload rawPayload)
                                            {
                                                <div class="ticket-history__preview ticket-history__preview--muted">@rawPayload.RawJson</div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(auditEvent.Actor))
                                            {
                                                <span class="ticket-history__actor">@auditEvent.Actor</span>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    }
                </MudPaper>
            </div>

            <aside class="ticket-detail-sidebar">
                <MudPaper Class="ticket-detail-surface ticket-context" Elevation="0">
                    <div class="ticket-sidebar-section">
                        <span class="ticket-panel__eyebrow">Context</span>

                        <dl class="ticket-context__grid">
                            <div class="ticket-context__row">
                                <dt>Status</dt>
                                <dd>
                                    <span class="@($"ticket-detail-badge ticket-detail-badge--status {StatusBadgeClass(_ticket.Status)}")">
                                        @FormatStatus(_ticket.Status)
                                    </span>
                                </dd>
                            </div>

                            <div class="ticket-context__row">
                                <dt>Priority</dt>
                                <dd>
                                    <span class="@($"ticket-detail-badge ticket-detail-badge--priority {PriorityBadgeClass(_ticket.Priority)}")">
                                        @FormatPriority(_ticket.Priority)
                                    </span>
                                </dd>
                            </div>

                            <div class="ticket-context__row">
                                <dt>Assignee</dt>
                                <dd>@(_ticket.Assignee ?? "Unassigned")</dd>
                            </div>

                            <div class="ticket-context__row">
                                <dt>Created</dt>
                                <dd>@FormatDateTime(_ticket.CreatedAt)</dd>
                            </div>

                            <div class="ticket-context__row">
                                <dt>Due</dt>
                                <dd class="@DueValueClass(_ticket)">@FormatDue(_ticket)</dd>
                            </div>
                        </dl>
                    </div>
                </MudPaper>

                <MudPaper Class="ticket-detail-surface ticket-next-steps" Elevation="0">
                    <div class="ticket-sidebar-section">
                        <span class="ticket-panel__eyebrow">Recommended next steps</span>
                        <ul class="ticket-next-steps__list">
                            @foreach (var suggestion in SuggestedNextSteps)
                            {
                                <li>@suggestion</li>
                            }
                        </ul>
                    </div>

                    <div class="ticket-sidebar-section ticket-next-steps__workflow">
                        <span class="ticket-panel__eyebrow">Allowed next</span>

                        @if (_ticket.AllowedTransitions.Count == 0)
                        {
                            <p class="ticket-next-steps__empty">No further workflow transition is currently available.</p>
                        }
                        else
                        {
                            <div class="ticket-next-steps__chips">
                                @foreach (var status in _ticket.AllowedTransitions)
                                {
                                    <span class="ticket-next-steps__chip">@FormatStatus(status)</span>
                                }
                            </div>
                        }
                    </div>
                </MudPaper>
            </aside>
        </div>
    </div>
}
