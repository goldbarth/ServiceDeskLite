@page "/tickets/board"

@using MudBlazor

@implements IDisposable

<PageTitle>Board</PageTitle>

<div class="board-page">
    <h1 class="u-screen-reader-only">Ticket board</h1>

    <DashboardHero Badge="Workflow board"
                   Title="Ticket board"
                   Description="Move service requests through a clear operational workflow with enough context to scan, prioritize, and act."
                   Stats="HeroStats" />

    <div class="board-toolbar">
        <div class="board-flow-surface">
            <span class="board-flow-surface__label">Workflow</span>

            <div class="board-flow" aria-label="Board workflow overview">
                @for (var i = 0; i < WorkflowSteps.Count; i++)
                {
                    var step = WorkflowSteps[i];

                    <div class="board-flow__step">
                        <span class="board-flow__step-label">@step.Label</span>
                        <span class="board-flow__step-caption">@step.Caption</span>
                    </div>

                    @if (i < WorkflowSteps.Count - 1)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.East"
                                 Class="board-flow__arrow"
                                 aria-hidden="true" />
                    }
                }
            </div>
        </div>

        <div class="board-toolbar__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/tickets/new"
                       Class="board-toolbar__new-ticket">
                New Ticket
            </MudButton>
        </div>
    </div>

    @if (BoardState.State is TicketBoardState.Error loadError)
    {
        <AppErrorPanel Error="loadError.ApiError" />
    }
    else if (BoardState.State is TicketBoardState.Idle or TicketBoardState.Loading)
    {
        <div class="board-skeleton">
            @foreach (var _ in VisibleColumns)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Height="540px"
                             Class="board-skeleton__column" />
            }
        </div>
    }
    else if (BoardState.State is TicketBoardState.Loaded loaded)
    {
        <MudPaper Class="board-surface" Elevation="0">
            <div class="board-scroll-wrapper">
                <div class="board-container @(_isDragging ? "board-container--dragging" : string.Empty)">
                    @foreach (var status in VisibleColumns)
                    {
                        var columnTickets = TicketsForColumn(loaded.Tickets, status);
                        var columnSpec = ColumnSpecs[status];

                        <section class="board-column @ColumnClass(status)"
                                 @ondragover:preventDefault
                                 @ondragenter="() => OnDragEnter(status)"
                                 @ondragleave="() => OnDragLeave(status)"
                                 @ondrop="() => OnDrop(status)">

                            <header class="board-column__header">
                                <div class="board-column__heading">
                                    <span class="board-column__eyebrow">@columnSpec.WorkflowHint</span>

                                    <div class="board-column__title-row">
                                        <h2 class="board-column__title">@FormatStatus(status)</h2>
                                        <span class="board-column__count">@columnTickets.Count</span>
                                    </div>

                                    <p class="board-column__description">@columnSpec.Description</p>
                                </div>

                                <div class="board-column__allowed">
                                    <span class="board-column__allowed-label">Allowed next</span>
                                    <span class="board-column__allowed-value">@AllowedNextText(columnTickets)</span>
                                </div>
                            </header>

                            @if (_isDragging)
                            {
                                <div class="@DropZoneClass(status)">
                                    <MudIcon Icon="@Icons.Material.Outlined.Download"
                                             Class="board-dropzone__icon"
                                             aria-hidden="true" />
                                    <span>@DropZoneText(status)</span>
                                </div>
                            }

                            <div class="board-column__body">
                                @if (columnTickets.Count == 0)
                                {
                                    <div class="board-column__empty">
                                        <span class="board-column__empty-label">No tickets</span>
                                        <p class="board-column__empty-text">@EmptyStateText(status)</p>
                                    </div>
                                }

                                @foreach (var ticket in columnTickets)
                                {
                                    <article class="board-card @(_draggingTicket?.Id == ticket.Id ? "board-card--dragging" : string.Empty)"
                                             draggable="true"
                                             @ondragstart="() => OnDragStart(ticket)"
                                             @ondragend="OnDragEnd">
                                        <div class="board-card__top">
                                            <div class="board-card__ref-row">
                                                <span class="board-card__drag-handle" aria-hidden="true">
                                                    <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" />
                                                </span>
                                                <span class="board-card__ref">@ticket.DisplayRef</span>
                                            </div>

                                            <span class="@($"board-priority {PriorityClass(ticket.Priority)}")">
                                                @FormatPriority(ticket.Priority)
                                            </span>
                                        </div>

                                        @* Wrapper takes the grid-item slot so the <a> is not a grid item: Chrome
                                           blockifies a grid item's legacy -webkit-box, which kills -webkit-line-clamp. *@
                                        <div class="board-card__title-row">
                                            <a href="/tickets/@ticket.Id" class="board-card__title">@ticket.Title</a>
                                        </div>
                                        <p class="board-card__summary">@BuildCardSummary(ticket)</p>

                                        <div class="board-card__meta">
                                            <span class="@DateClass(ticket)">
                                                <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                                                         Class="board-card__meta-icon"
                                                         aria-hidden="true" />
                                                @FormatBoardDate(ticket)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(ticket.Assignee))
                                            {
                                                <span class="board-card__meta-item">
                                                    <MudIcon Icon="@Icons.Material.Outlined.PersonOutline"
                                                             Class="board-card__meta-icon"
                                                             aria-hidden="true" />
                                                    @ticket.Assignee
                                                </span>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>
        </MudPaper>
    }
</div>
