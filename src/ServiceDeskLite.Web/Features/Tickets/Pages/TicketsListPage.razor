@page "/"
@page "/tickets"

@using MudBlazor
@using ServiceDeskLite.Web.Features.Tickets.State

<PageTitle>Tickets</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Tickets</MudText>

<MudPaper Elevation="1" Class="pa-3 mb-3">
    <div class="d-flex flex-wrap gap-3 align-items-end">
        <MudTextField T="string"
                      Label="Suche"
                      Placeholder="Titel oder Beschreibung..."
                      @bind-Value="_filterQ"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Disabled="@(State is TicketsListState.Loading)"
                      OnKeyDown="OnSearchKeyDownAsync" />

        <MudSelect T="TicketStatus"
                   Label="Status"
                   MultiSelection="true"
                   @bind-SelectedValues="_filterStatuses"
                   Dense="true"
                   Disabled="@(State is TicketsListState.Loading)">
            @foreach (var s in Enum.GetValues<TicketStatus>())
            {
                <MudSelectItem T="TicketStatus" Value="s">@s</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="TicketPriority"
                   Label="Priority"
                   MultiSelection="true"
                   @bind-SelectedValues="_filterPriorities"
                   Dense="true"
                   Disabled="@(State is TicketsListState.Loading)">
            @foreach (var p in Enum.GetValues<TicketPriority>())
            {
                <MudSelectItem T="TicketPriority" Value="p">@p</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string"
                      Label="Assignee"
                      Placeholder="Name..."
                      @bind-Value="_filterAssignee"
                      Disabled="@(State is TicketsListState.Loading)"
                      OnKeyDown="OnSearchKeyDownAsync" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="ApplyFiltersAsync"
                   Disabled="@(State is TicketsListState.Loading)">
            Suchen
        </MudButton>

        <MudButton Variant="Variant.Text"
                   OnClick="ClearFiltersAsync"
                   Disabled="@(State is TicketsListState.Loading)">
            Zurücksetzen
        </MudButton>
    </div>
</MudPaper>

@if (State is TicketsListState.Loading or TicketsListState.Idle)
{
    <MudSkeleton Height="32px" Width="220px" Class="mb-3" />
    <MudSkeleton Height="240px" />
}
else if (State is TicketsListState.Error err)
{
    <AppErrorPanel Error="err.ApiError" />
}
else if (State is TicketsListState.Loaded { Data.Items.Count: 0 })
{
    <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="1">
        <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber"
                 Color="Color.Default"
                 Style="font-size: 3rem; opacity: 0.35;"
                 Class="mb-3" />
        <MudText Typo="Typo.h6" Class="mb-1">Keine Tickets gefunden</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @(Query.HasActiveFilters()
                ? "Die aktiven Filter ergeben keine Treffer. Filter zurücksetzen oder Suchbegriff anpassen."
                : "Noch keine Tickets vorhanden. Lege das erste Ticket an.")
        </MudText>
        @if (Query.HasActiveFilters())
        {
            <MudButton Variant="Variant.Outlined" OnClick="ClearFiltersAsync">
                Filter zurücksetzen
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/tickets/new">
                Neues Ticket
            </MudButton>
        }
    </MudPaper>
}
else if (State is TicketsListState.Loaded loaded)
{
    var data = loaded.Data;

    <div class="d-flex align-items-center justify-content-between mb-2">
        <MudText Typo="Typo.caption">@data.TotalCount Gesamt</MudText>

        <div class="d-flex align-items-center gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync"
                           title="Reload" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/tickets/new"
                       Size="Size.Small">
                Neues Ticket
            </MudButton>

            <MudSelect T="int"
                       Dense="true"
                       Label="Page size"
                       Value="Query.PageSize"
                       ValueChanged="OnPageSizeChangedAsync"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="10">10</MudSelectItem>
                <MudSelectItem Value="25">25</MudSelectItem>
                <MudSelectItem Value="50">50</MudSelectItem>
                <MudSelectItem Value="100">100</MudSelectItem>
            </MudSelect>
        </div>
    </div>

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable T="TicketListItemResponse"
                  Items="data.Items"
                  Dense="true"
                  Hover="true"
                  OnRowClick="HandleRowClick">
            <HeaderContent>
                <MudTh>Id</MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => SortByAsync(TicketSortField.Title)">
                        Titel
                        @if (Query.SortField == TicketSortField.Title)
                        {
                            <MudIcon Icon="@SortIcon(TicketSortField.Title)" Class="ms-1" />
                        }
                    </MudButton>
                </MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => SortByAsync(TicketSortField.Status)">
                        Status
                        @if (Query.SortField == TicketSortField.Status)
                        {
                            <MudIcon Icon="@SortIcon(TicketSortField.Status)" Class="ms-1" />
                        }
                    </MudButton>
                </MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => SortByAsync(TicketSortField.Priority)">
                        Priority
                        @if (Query.SortField == TicketSortField.Priority)
                        {
                            <MudIcon Icon="@SortIcon(TicketSortField.Priority)" Class="ms-1" />
                        }
                    </MudButton>
                </MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => SortByAsync(TicketSortField.DueAt)">
                        DueAt
                        @if (Query.SortField == TicketSortField.DueAt)
                        {
                            <MudIcon Icon="@SortIcon(TicketSortField.DueAt)" Class="ms-1" />
                        }
                    </MudButton>
                </MudTh>
                <MudTh>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => SortByAsync(TicketSortField.CreatedAt)">
                        CreatedAt
                        @if (Query.SortField == TicketSortField.CreatedAt)
                        {
                            <MudIcon Icon="@SortIcon(TicketSortField.CreatedAt)" Class="ms-1" />
                        }
                    </MudButton>
                </MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Titel">@context.Title</MudTd>
                <MudTd DataLabel="Status">@context.Status</MudTd>
                <MudTd DataLabel="Priority">@context.Priority</MudTd>
                <MudTd DataLabel="DueAt">@(context.DueAt is null ? "-" : context.DueAt.Value.ToString("u"))</MudTd>
                <MudTd DataLabel="CreatedAt">@context.CreatedAt.ToString("u")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <div class="d-flex align-items-center justify-content-between mt-3">
        <MudText Typo="Typo.caption">
            Seite @Query.Page von @data.TotalPages — @data.TotalCount Gesamt (je @Query.PageSize)
        </MudText>

        <MudPagination Selected="Query.Page"
                       SelectedChanged="OnPageChangedAsync"
                       Count="@Math.Max(1, data.TotalPages)" />
    </div>
}
