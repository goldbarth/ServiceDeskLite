@using MudBlazor
@using ServiceDeskLite.Contracts.V1.Agents

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Assign Ticket</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingAgents)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            <MudSelect T="Guid?" Label="Assignee" @bind-Value="_selectedAgentId"
                       Placeholder="Unassigned"
                       Clearable="true"
                       Disabled="_isSubmitting"
                       Class="mb-4">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unassigned</MudSelectItem>
                @foreach (var agent in _agents)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)agent.Id)">@agent.Name</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_error is not null)
        {
            <AppErrorPanel Error="_error" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="@(_isSubmitting || _isLoadingAgents)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Apply
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ITicketsApiClient TicketsApi { get; set; } = default!;

    [Parameter] public Guid TicketId { get; set; }
    [Parameter] public string? CurrentAssignee { get; set; }

    private IReadOnlyList<AgentResponse> _agents = [];
    private Guid? _selectedAgentId;
    private bool _isLoadingAgents = true;
    private bool _isSubmitting;
    private ApiError? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await TicketsApi.GetAgentsAsync();
        if (result.IsSuccess)
        {
            _agents = result.Value!;
            // Preselect the current assignee by name (roster names are unique).
            _selectedAgentId = _agents.FirstOrDefault(a => a.Name == CurrentAssignee)?.Id;
        }
        else
        {
            _error = result.Error;
        }

        _isLoadingAgents = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _error = null;

        // null selection → unassign
        var result = await TicketsApi.AssignAsync(
            TicketId,
            new AssignTicketRequest(_selectedAgentId));

        _isSubmitting = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(result.Value!));
            return;
        }

        _error = result.Error;
    }
}
