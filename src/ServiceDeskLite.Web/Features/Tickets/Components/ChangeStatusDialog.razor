@using MudBlazor
@using ServiceDeskLite.Contracts.V1.Tickets

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Change Ticket Status</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="TicketStatus" Label="New Status" @bind-Value="_selectedStatus"
                   Disabled="@(_isSubmitting || !_hasSelectableStatus)" Class="mb-4">
            @foreach (var s in _allowedStatuses)
            {
                <MudSelectItem T="TicketStatus" Value="@s">@s</MudSelectItem>
            }
        </MudSelect>
        @if (_error is not null)
        {
            <AppErrorPanel Error="_error" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="@(_isSubmitting || !_hasSelectableStatus)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Apply
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ITicketsApiClient TicketsApi { get; set; } = default!;

    [Parameter] public Guid TicketId { get; set; }
    [Parameter] public IReadOnlyList<TicketStatus> AllowedStatuses { get; set; } = Array.Empty<TicketStatus>();

    private IReadOnlyList<TicketStatus> _allowedStatuses = [];
    private TicketStatus _selectedStatus;
    private bool _hasSelectableStatus;
    private bool _isSubmitting;
    private ApiError? _error;

    protected override void OnParametersSet()
    {
        _allowedStatuses = AllowedStatuses;
        _hasSelectableStatus = _allowedStatuses.Count > 0;
        _selectedStatus = _hasSelectableStatus ? _allowedStatuses[0] : default;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!_hasSelectableStatus)
            return;

        _isSubmitting = true;
        _error = null;

        var result = await TicketsApi.ChangeStatusAsync(
            TicketId,
            new ChangeTicketStatusRequest(_selectedStatus));

        _isSubmitting = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(result.Value!));
            return;
        }

        _error = result.Error;
    }
}
