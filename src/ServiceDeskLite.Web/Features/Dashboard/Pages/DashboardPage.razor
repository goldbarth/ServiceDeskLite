@page "/"
@page "/dashboard"

@using MudBlazor
@using ServiceDeskLite.Web.Components.Feedback

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <h1 class="u-screen-reader-only">Dashboard</h1>

    @if (_isLoading)
    {
        <MudSkeleton Height="214px" Class="dashboard-page__hero-skeleton" />

        <div class="dashboard-page__grid">
            @for (var i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="dashboard-page__card-skeleton" />
            }
        </div>
    }
    else if (_error is not null)
    {
        <AppErrorPanel Error="_error" />
    }
    else if (_summary is not null)
    {
        <DashboardHero Badge="Operations overview"
                       Title="Service desk dashboard"
                       Description="Monitor incoming demand, active case handling, and overdue pressure across the workspace."
                       Stats="HeroStats" />

        <div class="dashboard-page__grid">
            <KpiCard Label="New"
                     Value="@_summary.NewCount.ToString()"
                     Icon="@Icons.Material.Filled.FiberNew"
                     Accent="KpiAccent.Info"
                     ChipText="Live"
                     SupportingText="Awaiting first review" />

            <KpiCard Label="Triaged"
                     Value="@_summary.TriagedCount.ToString()"
                     Icon="@Icons.Material.Filled.Label"
                     Accent="KpiAccent.Highlight"
                     SupportingText="Ready for assignment" />

            <KpiCard Label="In Progress"
                     Value="@_summary.InProgressCount.ToString()"
                     Icon="@Icons.Material.Filled.Work"
                     Accent="KpiAccent.Caution"
                     SupportingText="Owned by active agents" />

            <KpiCard Label="Overdue"
                     Value="@_summary.OverdueCount.ToString()"
                     Icon="@Icons.Material.Filled.Alarm"
                     Accent="KpiAccent.Critical"
                     ChipText="Priority"
                     SupportingText="Needs immediate attention" />

            <KpiCard Label="Resolved (7d)"
                     Value="@_summary.ResolvedLast7DaysCount.ToString()"
                     Icon="@Icons.Material.Filled.CheckCircle"
                     Accent="KpiAccent.Positive"
                     SupportingText="Closed during the last week" />
        </div>
    }
</div>
