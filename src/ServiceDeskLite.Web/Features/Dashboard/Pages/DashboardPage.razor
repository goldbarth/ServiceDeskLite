@page "/"
@page "/dashboard"

@using MudBlazor
@using ServiceDeskLite.Web.Components.Feedback

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_isLoading)
{
    <MudGrid>
        @for (var i = 0; i < 5; i++)
        {
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudSkeleton Height="120px" />
            </MudItem>
        }
    </MudGrid>
}
else if (_error is not null)
{
    <AppErrorPanel Error="_error" />
}
else if (_summary is not null)
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <KpiCard Title="New"
                     Value="_summary.NewCount"
                     Icon="@Icons.Material.Filled.FiberNew"
                     Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <KpiCard Title="Triaged"
                     Value="_summary.TriagedCount"
                     Icon="@Icons.Material.Filled.Label"
                     Color="Color.Secondary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <KpiCard Title="In Progress"
                     Value="_summary.InProgressCount"
                     Icon="@Icons.Material.Filled.Work"
                     Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <KpiCard Title="Overdue"
                     Value="_summary.OverdueCount"
                     Icon="@Icons.Material.Filled.Alarm"
                     Color="Color.Error" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <KpiCard Title="Resolved (7d)"
                     Value="_summary.ResolvedLast7DaysCount"
                     Icon="@Icons.Material.Filled.CheckCircle"
                     Color="Color.Success" />
        </MudItem>
    </MudGrid>
}
