@using MudBlazor

<div class="kpi-card-shell @AccentClass">
    <MudPaper Class="kpi-card" Elevation="0">
        <div class="kpi-card__header">
            <span class="kpi-card__icon-surface" aria-hidden="true">
                <MudIcon Icon="@Icon" Class="kpi-card__icon" />
            </span>

            @if (!string.IsNullOrWhiteSpace(ChipText))
            {
                <MudChip T="string" Class="kpi-card__chip" Size="Size.Small">
                    @ChipText
                </MudChip>
            }
        </div>

        <div class="kpi-card__body">
            <div class="kpi-card__value">@Value</div>
            <div class="kpi-card__label">@Label</div>

            @if (!string.IsNullOrWhiteSpace(SupportingText))
            {
                <div class="kpi-card__support">@SupportingText</div>
            }
        </div>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Value { get; set; } = default!;
    [Parameter, EditorRequired] public string Icon { get; set; } = default!;
    [Parameter] public string? SupportingText { get; set; }
    [Parameter] public string? ChipText { get; set; }
    [Parameter] public string Accent { get; set; } = "slate";

    private string AccentClass
        => string.IsNullOrWhiteSpace(Accent)
            ? "kpi-card-shell--slate"
            : $"kpi-card-shell--{Accent.Trim().ToLowerInvariant()}";
}
