<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>

    <ResourcePreloader/>

    @* Kick bootstrap out *@
    @* <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/> *@

    @* Hello to MudBlazor CSS *@
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />

    @* Design tokens come from ServiceDeskLite.Web.Theme.DesignTokens, not from a stylesheet. *@
    @* MarkupString: the default encoder would escape the CSS into entities. *@
    <style>@((MarkupString)ServiceDeskLite.Web.Theme.AppTheme.RootCss)</style>

    @* Inline and before the stylesheets: the sdl-dark class must be on <html> at first
       paint, or a dark-mode user gets a white flash on every load. *@
    <script>
        (function () {
            const stored = localStorage.getItem("sdl-theme");
            const dark = stored === "dark" || stored === "light"
                ? stored === "dark"
                : matchMedia("(prefers-color-scheme: dark)").matches;
            if (dark) document.documentElement.classList.add("sdl-dark");
        })();
    </script>
    <script src="@Assets["theme.js"]"></script>

    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["ServiceDeskLite.Web.styles.css"]"/>

    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<ReconnectModal/>

<script src="@Assets["_framework/blazor.web.js"]"></script>

@* MudBlazor JS *@
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
