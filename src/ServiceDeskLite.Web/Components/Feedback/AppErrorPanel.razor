@using MudBlazor
@using ServiceDeskLite.Web.Api.V1

@inject IJSRuntime JS

<MudPaper Class="pa-4" Elevation="1">
    <MudAlert Severity="_severity" Variant="Variant.Outlined">
        <MudText Typo="Typo.h6" Class="mb-1">@_title</MudText>
        <MudText Typo="Typo.body2">@_message</MudText>

        @* TraceId — shown as copyable chip for support purposes *@
        @if (!string.IsNullOrWhiteSpace(_traceId))
        {
            <div class="d-flex align-items-center gap-2 mt-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Trace ID:</MudText>
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Icon="@Icons.Material.Outlined.ContentCopy"
                         OnClick="CopyTraceIdAsync"
                         title="Copy to clipboard">
                    @_traceId
                </MudChip>
            </div>
        }

        @* Technical details (error code, type, meta) — collapsed by default *@
        @if (!string.IsNullOrWhiteSpace(_code) || _meta is { Count: > 0 })
        {
            <MudExpansionPanels Class="mt-3" Elevation="0">
                <MudExpansionPanel Text="Technical Details">
                    @if (!string.IsNullOrWhiteSpace(_code))
                    {
                        <MudText Typo="Typo.caption">Code: @_code</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(_errorType))
                    {
                        <MudText Typo="Typo.caption">Type: @_errorType</MudText>
                    }
                    @if (_meta is { Count: > 0 })
                    {
                        <MudList T="string" Dense="true" Class="mt-1">
                            @foreach (var kv in _meta)
                            {
                                <MudListItem T="string">@kv.Key: @FormatMetaValue(kv.Value)</MudListItem>
                            }
                        </MudList>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudAlert>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ApiError Error { get; set; } = default!;

    private Severity _severity;
    private string _title = "Error";
    private string _message = "An unexpected error has occurred.";
    private string? _code;
    private string? _errorType;
    private string? _traceId;
    private Dictionary<string, object>? _meta;

    protected override void OnParametersSet()
    {
        _title = Error.Title ?? "Error";
        _message = Error.Detail ?? "An unexpected error has occurred.";
        _code = Error.Code;
        _errorType = Error.ErrorType;
        _traceId = Error.TraceId;
        _meta = Error.Meta;
        _severity = Error.Status switch
        {
            404 => Severity.Warning,
            400 => Severity.Warning,
            _   => Severity.Error
        };
    }

    private async Task CopyTraceIdAsync()
    {
        if (!string.IsNullOrWhiteSpace(_traceId))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _traceId);
    }

    private static string FormatMetaValue(object? value)
        => value is null ? "(null)" : value.ToString() ?? "(null)";
}
