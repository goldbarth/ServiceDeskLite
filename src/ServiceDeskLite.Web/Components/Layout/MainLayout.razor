@using Microsoft.JSInterop
@using MudBlazor
@using ServiceDeskLite.Web.Theme
@inherits LayoutComponentBase
@inject IJSRuntime Js

<MudThemeProvider Theme="@AppTheme.Theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="shell">
    <MudLayout Class="shell__layout">
        <MudAppBar Elevation="0" Dense="true" Class="shell-appbar">
            <div class="shell-appbar__inner">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                               Color="Color.Default"
                               Edge="Edge.Start"
                               Class="shell-appbar__menu-button"
                               OnClick="ToggleDrawer"
                               aria-label="Toggle navigation" />

                <div class="shell-appbar__brand">
                    <div class="shell-appbar__brand-mark">SD</div>
                    <div class="shell-appbar__brand-text">
                        <span class="shell-appbar__eyebrow">Operations</span>
                        <strong>ServiceDesk Lite</strong>
                    </div>
                </div>
                
                <MudSpacer />

                <div class="shell-appbar__search">
                    <TopSearch />
                </div>

                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Color="Color.Default"
                               Class="shell-appbar__theme-toggle"
                               OnClick="ToggleDarkModeAsync"
                               aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")" />

                <MudAvatar Size="Size.Medium" Class="shell-appbar__avatar">OP</MudAvatar>
            </div>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   Elevation="0"
                   Class="shell-drawer">
            <div class="shell-drawer__content">
                <div class="shell-drawer__header">
                    <span class="shell-drawer__eyebrow">Workspace</span>
                    <div class="shell-drawer__title">Daily operations</div>
                    <p class="shell-drawer__description">
                        Triage, monitor queues, and keep the service desk workload under control.
                    </p>
                </div>

                <NavMenu />
            </div>
        </MudDrawer>

        <MudMainContent Class="shell-main">
            <div class="shell-main__inner">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // The inline script in App.razor has already put the sdl-dark class on <html> before
    // first paint; this only aligns MudBlazor's palette with it once interop is available.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var isDark = await Js.InvokeAsync<bool>("sdlTheme.isDark");
        if (isDark != _isDarkMode)
        {
            _isDarkMode = isDark;
            StateHasChanged();
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await Js.InvokeVoidAsync("sdlTheme.apply", _isDarkMode);
    }
}
