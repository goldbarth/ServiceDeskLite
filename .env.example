# Copy to .env when a host port collides with another compose project.
# The container ports never change, so nothing inside the stack is affected.
#
#   cp .env.example .env

# Host port for Postgres. Only needed for local DB tooling (psql, DBeaver).
# Default 5432 collides with any other Postgres already running on the host.
DB_PORT=5432

# Host port for the API. Default 8080 collides with Keycloak, Tomcat, and most
# containerised .NET services. Point the Web client at it:
#   ApiClient__BaseUrl=http://localhost:8080
API_PORT=8080

# Secrets are read from the environment, not from this file's committed copy.
# ANTHROPIC_API_KEY=sk-ant-...
# VOYAGE_API_KEY=pa-...
