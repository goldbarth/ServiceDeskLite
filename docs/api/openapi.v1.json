  "info": {
    "title": "ServiceDeskLite.Api | v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/assistant/chat": {
      "post": {
        "description": "Streams the model response as Server-Sent Events (text, tool_call, tool_result, error, done). The model may create tickets via the create_ticket tool.",
        "operationId": "Assistant_Chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Chat with the AI assistant",
        "tags": [
          "Assistant"
        ]
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "description": "Returns aggregated KPI counts: active tickets by status, overdue tickets, and tickets resolved in the last 7 days.",
        "operationId": "Dashboard_GetSummary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummaryResponse"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get dashboard KPI summary",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/v1/tickets": {
      "get": {
        "description": "Returns a paged list of tickets with deterministic sorting (CreatedAt + Id).",
        "operationId": "Tickets_Search",
        "parameters": [
          {
            "in": "query",
            "name": "Page",
            "schema": {
              "default": 1,
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "PageSize",
            "schema": {
              "default": 25,
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "SortField",
            "schema": {
              "$ref": "#/components/schemas/TicketSortField"
            }
          },
          {
            "in": "query",
            "name": "SortDirection",
            "schema": {
              "$ref": "#/components/schemas/SortDirection"
            }
          },
          {
            "in": "query",
            "name": "Q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "Statuses",
            "schema": {
              "items": {
                "$ref": "#/components/schemas/TicketStatus"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "Priorities",
            "schema": {
              "items": {
                "$ref": "#/components/schemas/TicketPriority"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "Assignee",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfTicketListItemResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Search tickets",
        "tags": [
          "Tickets"
        ]
      },
      "post": {
        "operationId": "Tickets_Create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTicketResponse"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create a new ticket",
        "tags": [
          "Tickets"
        ]
      }
    },
    "/api/v1/tickets/{id}": {
      "get": {
        "operationId": "Tickets_GetById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get ticket by id",
        "tags": [
          "Tickets"
        ]
      },
      "patch": {
        "description": "Partial update of title, description, priority, or due date. Omitted fields stay unchanged.",
        "operationId": "Tickets_Update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
