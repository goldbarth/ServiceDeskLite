      "AuditEventPayload": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AuditEventPayloadTicketCreatedPayload"
          },
          {
            "$ref": "#/components/schemas/AuditEventPayloadTicketStatusChangedPayload"
          },
          {
            "$ref": "#/components/schemas/AuditEventPayloadTicketAssigneeChangedPayload"
          },
          {
            "$ref": "#/components/schemas/AuditEventPayloadTicketCommentAddedPayload"
          },
          {
            "$ref": "#/components/schemas/AuditEventPayloadTicketDetailsUpdatedPayload"
          },
          {
            "$ref": "#/components/schemas/AuditEventPayloadRawAuditEventPayload"
          }
        ],
        "discriminator": {
          "mapping": {
            "ticket.assignee_changed": "#/components/schemas/AuditEventPayloadTicketAssigneeChangedPayload",
            "ticket.comment_added": "#/components/schemas/AuditEventPayloadTicketCommentAddedPayload",
            "ticket.created": "#/components/schemas/AuditEventPayloadTicketCreatedPayload",
            "ticket.details_updated": "#/components/schemas/AuditEventPayloadTicketDetailsUpdatedPayload",
            "ticket.status_changed": "#/components/schemas/AuditEventPayloadTicketStatusChangedPayload",
            "unknown": "#/components/schemas/AuditEventPayloadRawAuditEventPayload"
          },
          "propertyName": "$type"
        },
        "required": [
          "$type"
        ],
        "type": "object"
      },
      "AuditEventPayloadRawAuditEventPayload": {
        "properties": {
          "$type": {
            "enum": [
              "unknown"
            ],
            "type": "string"
          },
          "rawJson": {
            "type": "string"
          }
        },
        "required": [
          "rawJson"
        ]
      },
      "AuditEventPayloadTicketAssigneeChangedPayload": {
        "properties": {
          "$type": {
            "enum": [
              "ticket.assignee_changed"
            ],
            "type": "string"
          },
          "newAssignee": {
            "type": [
              "null",
              "string"
            ]
          },
          "previousAssignee": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "previousAssignee",
          "newAssignee"
