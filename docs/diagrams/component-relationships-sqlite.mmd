classDiagram
    class ITicketRepository { <<interface>> }
    class IAuditEventRepository { <<interface>> }
    class IOutboxRepository { <<interface>> }
    class IDashboardRepository { <<interface>> }
    class IUnitOfWork { <<interface>> }

    class EfTicketRepository {
        <<Scoped>>
        +AddAsync(ticket, ct)
        +GetByIdAsync(id, ct)
        +ExistsAsync(id, ct)
        +SearchAsync(criteria, paging, sort, ct)
    }
    class EfAuditEventRepository {
        <<Scoped>>
        +AddAsync(auditEvent, ct)
        +GetByTicketIdAsync(ticketId, ct)
    }
    class EfOutboxRepository {
        <<Scoped>>
        +AddAsync(message, ct)
    }
    class EfDashboardRepository {
        <<Scoped>>
        +GetSummaryAsync(now, ct)
    }
    class EfUnitOfWork {
        <<Scoped>>
        +SaveChangesAsync(ct)
    }
    class ServiceDeskLiteDbContext {
        <<Scoped>>
        +DbSet~Ticket~ Tickets
        +DbSet~AuditEvent~ AuditEvents
        +DbSet~OutboxMessage~ OutboxMessages
    }

    EfTicketRepository ..|> ITicketRepository : implements
    EfAuditEventRepository ..|> IAuditEventRepository : implements
    EfOutboxRepository ..|> IOutboxRepository : implements
    EfDashboardRepository ..|> IDashboardRepository : implements
    EfUnitOfWork ..|> IUnitOfWork : implements
    EfTicketRepository --> ServiceDeskLiteDbContext : uses
    EfAuditEventRepository --> ServiceDeskLiteDbContext : uses
    EfOutboxRepository --> ServiceDeskLiteDbContext : uses
    EfDashboardRepository --> ServiceDeskLiteDbContext : uses
    EfUnitOfWork --> ServiceDeskLiteDbContext : uses