classDiagram
    class InMemoryStore {
        <<Singleton>>
        -ConcurrentDictionary~TicketId,Ticket~ _tickets
        -ConcurrentBag~AuditEvent~ _auditEvents
        -ConcurrentBag~OutboxMessage~ _outboxMessages
        +TryGetTicket(id, out ticket) bool
        +SnapshotTickets() IReadOnlyCollection~Ticket~
        +ApplyAdds(adds) void
        +AppendAuditEvents(events) void
        +GetAuditEventsByTicketId(ticketId) IReadOnlyList~AuditEvent~
        +AppendOutboxMessages(messages) void
    }
    class InMemoryUnitOfWork {
        <<Scoped>>
        +List~object~ PendingAdds
        +SaveChangesAsync(ct) Task
    }
    class InMemoryTicketRepository {
        <<Scoped>>
        +AddAsync(ticket, ct)
        +GetByIdAsync(id, ct)
        +ExistsAsync(id, ct)
        +SearchAsync(criteria, paging, sort, ct)
    }
    class InMemoryAuditEventRepository {
        <<Scoped>>
        +AddAsync(auditEvent, ct)
        +GetByTicketIdAsync(ticketId, ct)
    }
    class InMemoryOutboxRepository {
        <<Scoped>>
        +AddAsync(message, ct)
    }
    class InMemoryDashboardRepository {
        <<Scoped>>
        +GetSummaryAsync(now, ct)
    }
    class ITicketRepository { <<interface>> }
    class IAuditEventRepository { <<interface>> }
    class IOutboxRepository { <<interface>> }
    class IDashboardRepository { <<interface>> }
    class IUnitOfWork { <<interface>> }

    InMemoryTicketRepository ..|> ITicketRepository : implements
    InMemoryAuditEventRepository ..|> IAuditEventRepository : implements
    InMemoryOutboxRepository ..|> IOutboxRepository : implements
    InMemoryDashboardRepository ..|> IDashboardRepository : implements
    InMemoryUnitOfWork ..|> IUnitOfWork : implements
    InMemoryTicketRepository --> InMemoryStore : reads from
    InMemoryTicketRepository --> InMemoryUnitOfWork : buffers adds in
    InMemoryAuditEventRepository --> InMemoryStore : reads from
    InMemoryAuditEventRepository --> InMemoryUnitOfWork : buffers adds in
    InMemoryOutboxRepository --> InMemoryUnitOfWork : buffers adds in
    InMemoryDashboardRepository --> InMemoryStore : reads from
    InMemoryUnitOfWork --> InMemoryStore : commits to