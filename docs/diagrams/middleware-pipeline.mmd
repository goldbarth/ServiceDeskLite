flowchart LR
    Req([Incoming\nRequest])
    Req --> SL["UseApiRequestLogging\n(Serilog)"]
    SL --> OA["UseApiDocumentation\n(OpenAPI)"]
    OA --> EH["UseApiErrorHandling\n(ExceptionHandler)"]
    EH --> SEC["UseApiSecurity\n(ApiKeyMiddleware)"]
    SEC --> HTTPS[UseHttpsRedirection]
    HTTPS --> CORS["UseCors\n(WebFrontend policy)"]
    CORS --> EP[Endpoint\nRouting]
    EP --> Res([Response])